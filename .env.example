# Copy to .env and fill in. .env is gitignored.

# Required. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY='replace-me'

# Database: sqlite (default, no server needed) or postgresql
DB_ENGINE=sqlite
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Email: defaults to console output in development.
# EMAIL_BACKEND=apps.accounts.graph_email_backend.GraphEmailBackend
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=

# Where new-submission review notices go.
# NOTIFICATION_EMAIL=you@example.com

# Key for the Jev classification model, used by songfeat's `lyrics`
# feature group to read a song's words. Everything else in this tool
# works without it. See the "Lyric classification" section of README.md.
JEV_KEY=
